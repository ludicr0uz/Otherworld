# Unreal Engine 5 .gitignore

# Visual Studio / Xcode / Rider project files
*.VC.db
*.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
.idea/
.vscode/

# Compiled Binaries & Intermediates
Binaries/*
Intermediate/*
DerivedDataCache/*
Saved/*

# Unreal Build Tool / Generated files
Build/*
# ...but the packaged Mac app's Info.plist template is ours: it carries the key
# that keeps a full-screen game clear of the notch (root CLAUDE.md, Config).
!Build/Mac/
Build/Mac/*
!Build/Mac/Resources/
Build/Mac/Resources/*
!Build/Mac/Resources/Info.Template.plist
# ...and so is the launcher icon (Scripts/build_app_icons.py writes both).
!Build/Mac/Resources/Assets.xcassets/
!Build/Windows/
Build/Windows/*
!Build/Windows/Application.ico

# Autogenerated files
*-Debug.*
*-Development.*
*-Shipping.*
*-Test.*

# macOS / OS files
.DS_Store
*.swp
*~
Thumbs.db

# Everything that is not code. Downloads, generator scratch and any asset the
# project did not write itself live here, and none of it is committed --
# Scripts/forest_generator/asset_sources.py records where each one comes from
# and Scripts/sync_assets.py puts it back.
/assets/

# Python caches
__pycache__/
*.pyc

# ── Content/ is a Git LFS snapshot ───────────────────────────────────────────
#
# Content/ is committed through Git LFS (.gitattributes), so a clone can open
# the project without rebuilding it. The scripts in Scripts/ are still what
# write every asset, and Scripts/forest_generator/asset_sources.py records
# which script writes which directory:
#
#     python3 Scripts/sync_assets.py --status    what is present
#     python3 Scripts/sync_assets.py --plan      how to rebuild it from nothing
Content/Python/__pycache__/

# The Game Animation Sample's motion-matching set: 2.9 GB copied from Epic's
# sample project by Scripts/asset_pipeline/import_gas.py, which puts it back.
/Content/GAS/

# Lyra's characters and clips, a Fab pack the user adds by hand
# (Scripts/asset_pipeline/fab_library.json), and what
# Scripts/asset_pipeline/import_lyra.py retargets from them.
/Content/Sourced/Lyra/

# The Fab asset library: packs and raw downloads kept on disk to pick from,
# not part of the game until something in it is used. Scripts/asset_pipeline/
# fab_library.json records each one and fab_scan.py / fab_raw_scan.py put it
# back. To ship one item, copy or move it into a committed folder (or add a
# `!` line for its folder here) so it goes through Git LFS with the game.
/Content/Fab/**
!/Content/Fab/**/
/Content/AnimStarterPack/**
!/Content/AnimStarterPack/**/
/Content/FP_AKS74U_Animation/
/Content/FreeAnimationLibrary/**
!/Content/FreeAnimationLibrary/**/
/Content/FreeLadderAnimationSet/
/Content/Megaplant_Library/
/Content/Survival_Character/

# What the game plays out of those packs: the pistol and the shotgun
# (Weapons/BP_Pistol, BP_Shotgun) and the rifle-hip and prone clips
# (Sourced/MetaHuman/ABP_WeaponLayers). A build cooks these, so they are
# committed; `**` and not the folder, as for the two packs below.
!/Content/AnimStarterPack/UEFN_Player/A_UEFN_Player_Crouch_Idle_Rifle_Hip.uasset
!/Content/AnimStarterPack/UEFN_Player/A_UEFN_Player_Crouch_Walk_Fwd_Rifle_Hip.uasset
!/Content/AnimStarterPack/UEFN_Player/A_UEFN_Player_Idle_Rifle_Hip.uasset
!/Content/AnimStarterPack/UEFN_Player/A_UEFN_Player_Jog_Fwd_Rifle.uasset
!/Content/AnimStarterPack/UEFN_Player/A_UEFN_Player_Sprint_Fwd_Rifle.uasset
!/Content/Fab/1911_Pistol_High_Poly/M_1911.uasset
!/Content/Fab/1911_Pistol_High_Poly/SM_1911_02.uasset
!/Content/Fab/1911_Pistol_High_Poly/T_1911_AO.uasset
!/Content/Fab/1911_Pistol_High_Poly/T_1911_C.uasset
!/Content/Fab/1911_Pistol_High_Poly/T_1911_M.uasset
!/Content/Fab/1911_Pistol_High_Poly/T_1911_N.uasset
!/Content/Fab/1911_Pistol_High_Poly/T_1911_R2.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/M_Shotgun_02.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/SM_Shotgun_02.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/T_Shotgun_02_AO.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/T_Shotgun_02_C.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/T_Shotgun_02_M.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/T_Shotgun_02_N.uasset
!/Content/Fab/Shotgun_Pump_Action_Wooden_Stock_Hish_Poly/T_Shotgun_02_R.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Fwd_Left_Loop.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Fwd_Loop_R.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Fwd_Right_Loop.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Idle.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Left_loop.uasset
!/Content/FreeAnimationLibrary/UEFN_Player/A_UEFN_Player_anim_Prone_Right_Loop.uasset

# Two library packs the levels plant one mesh each from: the grass and the
# bushes (Scripts/forest_generator/undergrowth_meshes.py, whose
# gitignore_lines() prints the `!` lines). Everything in them is ignored but
# what those two meshes need; `**` and not the folder, because git cannot
# re-include a file whose folder is ignored.
/Content/Light_Foliage/**
!/Content/Light_Foliage/**/
!/Content/Light_Foliage/Materials/MI_Branch.uasset
!/Content/Light_Foliage/Materials/MI_Bush_02.uasset
!/Content/Light_Foliage/Materials/Master_Materials/M_Master_Foliage.uasset
!/Content/Light_Foliage/Meshes/SM_Bush_02.uasset
!/Content/Light_Foliage/Textures/T_Bush_02_Mask.uasset
!/Content/Light_Foliage/Textures/T_Bush_02_Normal.uasset
!/Content/Light_Foliage/Textures/T_Bush_04_Normal.uasset
!/Content/Light_Foliage/Textures/T_Bush_Branch_Mask.uasset
/Content/PN_GrassLibrary/**
!/Content/PN_GrassLibrary/**/
!/Content/PN_GrassLibrary/Materials/MaterialFunctions/PN_AnimationShader.uasset
!/Content/PN_GrassLibrary/Materials/MaterialFunctions/PN_Bending.uasset
!/Content/PN_GrassLibrary/Materials/MaterialFunctions/PN_BendingParameters.uasset
!/Content/PN_GrassLibrary/Materials/MaterialFunctions/PN_MultiBend.uasset
!/Content/PN_GrassLibrary/Materials/MaterialFunctions/PN_WindAnimation.uasset
!/Content/PN_GrassLibrary/Materials/PN_WindParameters.uasset
!/Content/PN_GrassLibrary/Materials/grassMaterials/MA_Grass.uasset
!/Content/PN_GrassLibrary/Materials/grassMaterials/grassMaterials/grass_02_09_Mat.uasset
!/Content/PN_GrassLibrary/Meshes/grassMesh/grass_02_09_mesh.uasset
!/Content/PN_GrassLibrary/Textures/grassTextures/MasterTextures/springGrass_Albedo_8k_I.uasset
!/Content/PN_GrassLibrary/Textures/grassTextures/MasterTextures/springGrass_Normal_springGrass_8k.uasset
!/Content/PN_GrassLibrary/Textures/grassTextures/MasterTextures/springGrass_Opacity_8k.uasset
!/Content/PN_GrassLibrary/Textures/grassTextures/PivPainterTextures/grass_02_09_PIV.uasset
!/Content/PN_GrassLibrary/Textures/grassTextures/PivPainterTextures/grass_02_09_VEC.uasset

# Generator sidecars: megabytes apiece, and fully determined by the seed.
Scripts/generated_levels/*/grass_*.json
Scripts/generated_levels/*/*.obj

# Diagnostic dumps written by one-off inspection scripts.
Scripts/*_out.txt
