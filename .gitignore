# Unreal Engine 5 .gitignore

# Visual Studio / Xcode / Rider project files
*.VC.db
*.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
.idea/
.vscode/

# Compiled Binaries & Intermediates
Binaries/*
Intermediate/*
DerivedDataCache/*
Saved/*

# Unreal Build Tool / Generated files
Build/*

# Autogenerated files
*-Debug.*
*-Development.*
*-Shipping.*
*-Test.*

# macOS / OS files
.DS_Store
*.swp
*~
Thumbs.db

# Temporary Download Caches
Scripts/downloaded_scanned_assets/
Scripts/generated_assets/
Scripts/generated_realistic_assets/

# Ignore generated heavy assets for Code-Only Repo
Content/Forest/
Content/Maps/
