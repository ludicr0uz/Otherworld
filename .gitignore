# Unreal Engine 5 .gitignore

# Visual Studio / Xcode / Rider project files
*.VC.db
*.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
.idea/
.vscode/

# Compiled Binaries & Intermediates
Binaries/*
Intermediate/*
DerivedDataCache/*
Saved/*

# Unreal Build Tool / Generated files
Build/*
# ...but the packaged Mac app's Info.plist template is ours: it carries the key
# that keeps a full-screen game clear of the notch (root CLAUDE.md, Config).
!Build/Mac/
Build/Mac/*
!Build/Mac/Resources/
Build/Mac/Resources/*
!Build/Mac/Resources/Info.Template.plist

# Autogenerated files
*-Debug.*
*-Development.*
*-Shipping.*
*-Test.*

# macOS / OS files
.DS_Store
*.swp
*~
Thumbs.db

# Everything that is not code. Downloads, generator scratch and any asset the
# project did not write itself live here, and none of it is committed --
# Scripts/forest_generator/asset_sources.py records where each one comes from
# and Scripts/sync_assets.py puts it back.
/assets/

# Python caches
__pycache__/
*.pyc

# ── Content/ is a Git LFS snapshot ───────────────────────────────────────────
#
# Content/ is committed through Git LFS (.gitattributes), so a clone can open
# the project without rebuilding it. The scripts in Scripts/ are still what
# write every asset, and Scripts/forest_generator/asset_sources.py records
# which script writes which directory:
#
#     python3 Scripts/sync_assets.py --status    what is present
#     python3 Scripts/sync_assets.py --plan      how to rebuild it from nothing
Content/Python/__pycache__/

# The Game Animation Sample's motion-matching set: 2.9 GB copied from Epic's
# sample project by Scripts/asset_pipeline/import_gas.py, which puts it back.
/Content/GAS/

# Generator sidecars: megabytes apiece, and fully determined by the seed.
Scripts/generated_levels/*/grass_*.json
Scripts/generated_levels/*/*.obj

# Diagnostic dumps written by one-off inspection scripts.
Scripts/*_out.txt
